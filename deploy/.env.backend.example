# Docker backend runtime (not for local `uv run uvicorn`).
# Copy to deploy/.env.backend and fill WeChat / SMTP.
# Keep SQLITE_PATH=/data/amtsm.db so the host bind mount (SQLITE_DATA_DIR) is used.

APP_ENV=production
API_HOST=0.0.0.0
API_PORT=8800
SQLITE_PATH=/data/amtsm.db
TZ=Asia/Shanghai

# Browser origins that open the UI through nginx (scheme + host + optional port).
# Port 80: http://localhost. Other HTTP_PORT: http://localhost:8080.
# Add every origin you use (LAN IP, domain).
CORS_ORIGINS=http://localhost

POLLING_INTERVAL_SECONDS=30
INTRADAY_SNAPSHOT_INTERVAL_SECONDS=60
POLLING_BATCH_SIZE=50
POLLING_REQUEST_TIMEOUT_SECONDS=3
POLLING_REQUEST_RETRIES=1

# Data source placeholder
TUSHARE_TOKEN=

# Notification channels: comma-separated, wechat and/or email (default wechat)
NOTIFY_CHANNELS=email

# SMTP email notifier
# Required: SMTP_HOST, SMTP_FROM, SMTP_TO (comma-separated recipients)
# Username/password optional (unauthenticated local SMTP)
SMTP_HOST=smtp.126.com
SMTP_PORT=465
# 邮箱 126
SMTP_USERNAME=haojianli_me@126.com
SMTP_PASSWORD=TRjvV337UtDP9Y2n
SMTP_FROM=haojianli_me@126.com
SMTP_TO=yukaizhao@foxmail.com
SMTP_USE_TLS=true
SMTP_USE_SSL=true
SMTP_TIMEOUT_SECONDS=10
SMTP_SUBJECT=AMTSM 通知
SMTP_SELF_CHECK_ON_STARTUP=false

# Buy-signal alert retries (user story 08)
ALERT_SEND_MAX_RETRIES=3
ALERT_SEND_RETRY_BACKOFF_SECONDS=0.5
# Max successful notifications per stock per trade date (0 = unlimited)
ALERT_MAX_PER_STOCK_PER_DAY=1