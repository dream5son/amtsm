{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "default": {
      "format": "%(asctime)s %(levelname)s [%(name)s] %(message)s"
    }
  },
  "handlers": {
    "console": {
      "class": "logging.StreamHandler",
      "formatter": "default",
      "stream": "ext://sys.stdout"
    },
    "file": {
      "class": "logging.handlers.RotatingFileHandler",
      "formatter": "default",
      "filename": "/var/log/amtsm/backend.log",
      "maxBytes": 10485760,
      "backupCount": 3
    }
  },
  "root": {
    "level": "INFO",
    "handlers": ["console", "file"]
  },
  "loggers": {
    "uvicorn": {
      "handlers": ["console", "file"],
      "level": "INFO",
      "propagate": false
    },
    "uvicorn.error": {
      "handlers": ["console", "file"],
      "level": "INFO",
      "propagate": false
    },
    "uvicorn.access": {
      "handlers": ["console", "file"],
      "level": "INFO",
      "propagate": false
    },
    "apscheduler.executors.default": {
      "level": "WARNING",
      "propagate": true
    },
    "apscheduler.scheduler": {
      "level": "WARNING",
      "propagate": true
    }
  }
}
