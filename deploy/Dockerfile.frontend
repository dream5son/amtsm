# Node 22 (matches @types/node 22.x; Next 15 / Tailwind 4 require >=20)
FROM node:22-bookworm-slim AS builder

WORKDIR /app
ARG NEXT_PUBLIC_API_BASE_URL=
ENV NEXT_TELEMETRY_DISABLED=1 \
    NEXT_PUBLIC_API_BASE_URL=${NEXT_PUBLIC_API_BASE_URL}

RUN corepack enable && corepack prepare pnpm@11.20.0 --activate

COPY .npmrc pnpm-lock.yaml pnpm-workspace.yaml ./
COPY frontend/package.json ./frontend/package.json
RUN pnpm install --frozen-lockfile --filter amtsm-frontend...

COPY frontend ./frontend
RUN pnpm --filter amtsm-frontend build

FROM node:22-bookworm-slim AS runner

WORKDIR /app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3800 \
    HOSTNAME=0.0.0.0 \
    TZ=Asia/Shanghai

RUN apt-get update \
    && apt-get install -y --no-install-recommends tzdata ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# outputFileTracingRoot is the repo root, so standalone layout is frontend/server.js
COPY --from=builder /app/frontend/.next/standalone ./
COPY --from=builder /app/frontend/.next/static ./frontend/.next/static

RUN chown -R node:node /app
USER node

EXPOSE 3800
CMD ["node", "frontend/server.js"]
