# Shared
APP_ENV=development
TZ=Asia/Shanghai

# Backend
API_HOST=0.0.0.0
API_PORT=8000
SQLITE_PATH=data/amtsm.db
POLLING_INTERVAL_SECONDS=5
POLLING_BATCH_SIZE=50
POLLING_REQUEST_TIMEOUT_SECONDS=3
POLLING_REQUEST_RETRIES=3
POLLING_REQUEST_RETRY_BACKOFF_SECONDS=0.5
POLLING_CONSECUTIVE_FAILURE_THRESHOLD=5
SNAPSHOT_HOUR=15
SNAPSHOT_MINUTE=30
SNAPSHOT_FETCH_RETRIES=2
SNAPSHOT_FETCH_RETRY_BACKOFF_SECONDS=0.5
TUSHARE_TOKEN=

# WeChat enterprise app (user story 07)
# Install: uv sync (includes wechatpy[cryptography])
# CorpID / AgentId / Secret from 企业微信管理后台 → 应用管理
# WECHAT_TO_USER: UserID, multi-user joined by |, or @all
WECHAT_CORP_ID=
WECHAT_AGENT_ID=
WECHAT_SECRET=
WECHAT_TO_USER=
WECHAT_REQUEST_TIMEOUT_SECONDS=10
WECHAT_SELF_CHECK_ON_STARTUP=true

# Buy-signal alert retries (user story 08)
ALERT_SEND_MAX_RETRIES=3
ALERT_SEND_RETRY_BACKOFF_SECONDS=0.5

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
