# Local `pnpm dev`: browser calls FastAPI on :8000.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Docker: do not put localhost:8000 into the image. Compose builds with an empty
# NEXT_PUBLIC_API_BASE_URL so the UI calls same-origin /api through nginx.
# Runtime still loads this file (and frontend/.env) via docker-compose env_file.
