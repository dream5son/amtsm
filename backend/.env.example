APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
# Local: relative to the process cwd. Docker Compose overrides this to /data/amtsm.db.
SQLITE_PATH=data/amtsm.db
# Comma-separated browser origins allowed by CORS.
# Local: http://localhost:3000. Docker/nginx on :80: also include http://localhost.
# Add every origin you use to open the UI (scheme + host + optional port).
CORS_ORIGINS=http://localhost:3000,http://localhost
POLLING_INTERVAL_SECONDS=5
INTRADAY_SNAPSHOT_INTERVAL_SECONDS=60
POLLING_BATCH_SIZE=50
POLLING_REQUEST_TIMEOUT_SECONDS=3
POLLING_REQUEST_RETRIES=1

# Data source placeholder
TUSHARE_TOKEN=

# Notification channels: comma-separated, wechat and/or email (default wechat)
NOTIFY_CHANNELS=wechat

# WeChat enterprise notifier (user story 07)
# wechatpy is installed via: uv sync  (wechatpy[cryptography])
# Fill CorpID / AgentId / Secret from 企业微信管理后台应用详情
# WECHAT_TO_USER: enterprise UserID; multi-user: zhangsan|lisi ; or @all
WECHAT_CORP_ID=
WECHAT_AGENT_ID=
WECHAT_SECRET=
WECHAT_TO_USER=YukaiSir
WECHAT_REQUEST_TIMEOUT_SECONDS=10
WECHAT_SELF_CHECK_ON_STARTUP=true

# SMTP email notifier
# Required: SMTP_HOST, SMTP_FROM, SMTP_TO (comma-separated recipients)
# Login: SMTP_USERNAME (alias: SMTP_USER). If empty, SMTP_FROM is used when a password is set.
# Port 465 uses implicit SSL automatically; port 587 uses STARTTLS (SMTP_USE_TLS).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=10
SMTP_SUBJECT=AMTSM 通知
SMTP_SELF_CHECK_ON_STARTUP=true

# Buy-signal alert retries (user story 08)
ALERT_SEND_MAX_RETRIES=3
ALERT_SEND_RETRY_BACKOFF_SECONDS=0.5
# Max successful notifications per stock per trade date (0 = unlimited)
ALERT_MAX_PER_STOCK_PER_DAY=0
