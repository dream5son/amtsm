APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
SQLITE_PATH=data/amtsm.db
POLLING_INTERVAL_SECONDS=5
POLLING_BATCH_SIZE=50
POLLING_REQUEST_TIMEOUT_SECONDS=3
POLLING_REQUEST_RETRIES=1

# Data source placeholder
TUSHARE_TOKEN=

# WeChat enterprise notifier (user story 07)
# wechatpy is installed via: uv sync  (wechatpy[cryptography])
# Fill CorpID / AgentId / Secret from 企业微信管理后台应用详情
# WECHAT_TO_USER: enterprise UserID; multi-user: zhangsan|lisi ; or @all
WECHAT_CORP_ID=
WECHAT_AGENT_ID=
WECHAT_SECRET=
WECHAT_TO_USER=
WECHAT_REQUEST_TIMEOUT_SECONDS=10
WECHAT_SELF_CHECK_ON_STARTUP=true

# Buy-signal alert retries (user story 08)
ALERT_SEND_MAX_RETRIES=3
ALERT_SEND_RETRY_BACKOFF_SECONDS=0.5
